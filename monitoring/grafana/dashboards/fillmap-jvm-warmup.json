      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(hikaricp_connections_usage_seconds_sum[10s]) / rate(hikaricp_connections_usage_seconds_count[10s])",
          "legendFormat": "usage 평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_usage_seconds_max",
          "legendFormat": "usage max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hikari 풀 상태 — active 가 max(10)에 붙고 pending 이 서면 고갈",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
