    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU · Young GC — 글의 '배포 직후 급증' 대조",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
