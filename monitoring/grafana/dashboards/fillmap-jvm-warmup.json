{
  "uid": "fillmap-jvm-warmup",
  "title": "FillMap · JVM 워밍업 콜드/웜 비교",
  "tags": [
    "fillmap",
    "jvm-warmup"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "지도 홈 API p99 (uri별) — 배포 직후 기둥이 보이는 자리",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/grids|/api/missions/aggregation|/api/hotzones/aggregation|/api/regions/reverse-geocode\"}[10s])) by (le, uri))",
          "legendFormat": "{{uri}} p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "지도 홈 API p95 (uri별)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/grids|/api/missions/aggregation|/api/hotzones/aggregation|/api/regions/reverse-geocode\"}[10s])) by (le, uri))",
          "legendFormat": "{{uri}} p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari 커넥션 획득 시간 (acquire) — 글의 '5~10초' 자리",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[10s]) / rate(hikaricp_connections_acquire_seconds_count[10s])",
          "legendFormat": "acquire 평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_acquire_seconds_max",
          "legendFormat": "acquire max"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hikari 커넥션 점유 시간 (usage) — 글의 '1~1.5초' 자리",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
